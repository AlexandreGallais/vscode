/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "paths": {
      "lib": ["./dist/lib"]
    },
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2025",
    "module": "preserve",
    "lib": ["DOM", "ESNext"],

    "strict": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true
    /* noUnusedLocals, noUnusedParameters and allowUnreachableCode are left to ESLint: dead code fails the lint, not the build. */
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    /* strictTemplates and typeCheckHostBindings default to true in Angular 22. */
    /* Template diagnostics fail the build, except unused or useless code (left as warnings, like noUnusedLocals). */
    "extendedDiagnostics": {
      "defaultCategory": "error",
      "checks": {
        "nullishCoalescingNotNullable": "warning",
        "optionalChainNotNullable": "warning",
        "unusedLetDeclaration": "warning",
        "unusedStandaloneImports": "warning"
      }
    }
  },
  "files": [],
  "references": [
    {
      "path": "./shell/tsconfig.app.json"
    },
    {
      "path": "./shell/tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.test.json"
    },
    {
      "path": "./lib/tsconfig.lib.json"
    },
    {
      "path": "./lib/tsconfig.spec.json"
    }
  ]
}
